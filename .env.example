# Copy to .env. Never commit real credentials.
# Generate a separate API access token: python -c "import secrets; print(secrets.token_urlsafe(32))"
NAVIGATOR_API_TOKEN=replace_with_a_random_token_of_at_least_32_characters
# Authorization key (Base64 Client ID:Client Secret) from GigaChat, without "Basic ".
GIGACHAT_API_KEY=replace_with_your_gigachat_authorization_key
# Select the scope matching your GigaChat account.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
REQUEST_TIMEOUT_SECONDS=30
# Optional PEM trust bundle including required root certificates. TLS verification stays enabled.
# CA_BUNDLE=/absolute/path/to/trusted-ca-bundle.pem
