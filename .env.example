# AI Navigator - Environment Configuration Example
# Copy this file to .env and fill in your actual values

# GigaChat API Configuration
GIGACHAT_API_KEY=your_gigachat_api_key_here
GIGACHAT_SCOPE=GIGACHAT_API_CORP

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ai_navigator
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TITLE=AI Navigator - Predictive Incident Detection

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# RAG (Retrieval-Augmented Generation) Configuration
RAG_MODEL_PATH=./models/rag_model
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# PII Anonymization Rules
ANONYMIZATION_ENABLED=true
ANONYMIZATION_RULES_PATH=./config/anonymization_rules.json
ANONYMIZE_EMAIL=true
ANONYMIZE_PHONE=true
ANONYMIZE_NAMES=true
ANONYMIZE_IDS=true

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External Services
INCIDENT_API_URL=https://api.example.com/incidents
INCIDENT_API_KEY=your_incident_api_key_here

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_SMTP_SERVER=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_FROM_ADDRESS=noreply@example.com

# Feature Flags
ENABLE_RAG_MODE=true
ENABLE_REAL_TIME_PROCESSING=true
ENABLE_BATCH_PROCESSING=true

# Performance Settings
MAX_WORKERS=4
BATCH_SIZE=100
REQUEST_TIMEOUT_SECONDS=30
